<section xml:id="c10-details">
	<title>Laplace Transforms</title>

	<paragraphs xml:id="lt-roadmap-example-1">
    <title>Specific-Roadmap</title>

    <sidebyside widths="30% 15% 47%" valign="middle">
      <p><md>\small\ul{\quad\ \textbf{Original Domain}\ \quad}</md></p>
      <p/>
      <p><md>\small\DLBa\textbf{2️⃣  Laplace Domain}</md></p>
    </sidebyside>
    <sidebyside widths="29% 15% 48%" valign="top">
      <p>
        <md>
          <mrow>\small \os{\vphantom{m}}{ y'' + 5y' + 6y = 0}</mrow>
          <mrow>\small y(0) = 2,\ y'(0) = -1</mrow>
          <mrow>\small \os{\large 🔻 🔻 🔻 🔻 🔻}{\text{Differential Equation}}</mrow>
          <mrow/>
          <mrow>\small \us{\large 🔻 🔻 🔻 🔻 🔻}{\text{Solution}}</mrow>
          <mrow>\small y(t) = 5e^{-2t} - 3e^{-3t}</mrow>
        </md>
      </p>
      <p>
        <md>
          <mrow>\small \underrightarrow{\text{1️⃣ Forward}}</mrow>
          <mrow>\small \text{Apply}\ \laplacesym</mrow>
          <mrow/>
          <mrow/>
          <mrow/>
          <mrow>\small \text{Apply}\ \laplacesym^{-1}</mrow>
          <mrow>\small \overleftarrow{\text{3️⃣ Backward}}</mrow>
        </md>
      </p>
      <p>
        <!-- <assemblage>
          <p> -->
            <md>
              <mrow>\amp\small\DLBa s^2Y - 2s + 1 + 5sY - 10 + 6Y = 0</mrow>
              <mrow>\amp\small\qquad\qquad {\Big\downarrow}\quad\text{Solve for}\ Y</mrow>
              <mrow>\amp\small\DLBa Y(s) = \frac{2s + 9}{s^2 + 5s + 6}</mrow>
              <mrow>\amp\small\qquad\qquad {\Big\downarrow}\ \ \text{Prepare for Inverse}</mrow>
              <mrow>\amp\small\DLBa Y(s) = \frac{5}{s + 2} - \frac{3}{s + 3}</mrow>
            </md>
          <!-- </p>
        </assemblage> -->
      </p>
    </sidebyside>
  </paragraphs>

  <paragraphs xml:id="lt-roadmap-example-2">
		<title>Specific-Roadmap</title>
    <sidebyside widths="25% 14% 52%" valign="middle">
      <p><md>\small\ul{\quad\ \textbf{Original Domain}\ \quad}</md></p>
      <p/>
      <p><md>\small\DLBa\textbf{2️⃣ Laplace Domain}</md></p>
    </sidebyside>
    <sidebyside widths="25% 14% 52%" valign="top">
      <p>
        <md>
          <mrow>\small \os{\vphantom{m}}{ y'' - 2y' + y = e^{t}}</mrow>
          <mrow>\small y(0) = 0,\ y'(0) = 1</mrow>
          <mrow>\small \os{\large 🔺 🔺 🔺 🔺 🔺}{\text{Differential Equation}}</mrow>
          <mrow/>
          <mrow/>
          <mrow>\small \us{\large 🔻 🔻 🔻 🔻 🔻}{\text{Solution}}</mrow>
          <mrow>\small y(t) = t e^{t} + \frac12 t^2 e^{t}</mrow>
        </md>
      </p>
      <p>
        <md>
          <mrow>\small \underrightarrow{\text{1️⃣ Forward}}</mrow>
          <mrow>\small \text{Apply}\ \laplacesym</mrow>
          <mrow/>
          <mrow/>
          <mrow/>
          <mrow/>
          <mrow>\small \text{Apply}\ \laplacesym^{-1}</mrow>
          <mrow>\small \overleftarrow{\text{3️⃣ Backward}}</mrow>
        </md>
      </p>
      <p>
        <!-- <assemblage>
          <p> -->
            <md>
              <mrow>\amp\small\DLBa s^2Y - sy(0) - y'(0)</mrow>
              <mrow>\amp\small\DLBa \qquad\qquad - 2(sY - y(0)) + Y = \frac{1}{s-1}</mrow>
              <mrow>\amp\small\qquad\qquad {\Big\downarrow}\quad\text{Solve for}\ Y</mrow>
              <mrow>\amp\small\DLBa Y(s) = \frac{1}{(s-1)^3} + \frac{1}{(s-1)^2}</mrow>
              <mrow>\amp\small\qquad\qquad {\Big\downarrow}\ \ \text{Prepare for Inverse}</mrow>
              <mrow>\amp\small\DLBa Y(s)\ \text{already matches}</mrow>
            </md>
          <!-- </p>
        </assemblage> -->
      </p>
    </sidebyside>
  </paragraphs>

  <paragraphs xml:id="lt-roadmap-example-3">
		<title>Specific-Roadmap</title>
    <sidebyside widths="32% 14% 46%" valign="middle">
      <p><md>\small\ul{\quad\ \textbf{Original Domain}\ \quad}</md></p>
      <p/>
      <p><md>\small\DLBa\textbf{2️⃣ Laplace Domain}</md></p>
    </sidebyside>
    <sidebyside widths="32% 14% 46%" valign="top">
      <p>
        <md>
          <mrow>\small \os{\vphantom{m}}{ y'' + y = t^2 }</mrow>
          <mrow>\small y(0) = 1,\ y'(0) = 0</mrow>
          <mrow>\small \os{\large 🔻 🔻 🔻 🔻 🔻}{\text{Differential Equation}}</mrow>
          <mrow/>
          <mrow>\small \us{\large 🔻 🔻 🔻 🔻 🔻}{\text{Solution}}</mrow>
          <mrow>\small y(t) = 3\cos(t) + t^2 - 2</mrow>
        </md>
      </p>
      <p>
        <md>
          <mrow>\small \underrightarrow{\text{1️⃣ Forward}}</mrow>
          <mrow>\small \text{Apply}\ \laplacesym</mrow>
          <mrow/>
          <mrow/>
          <mrow/>
          <mrow>\small \text{Apply}\ \laplacesym^{-1}</mrow>
          <mrow>\small \overleftarrow{\text{3️⃣ Backward}}</mrow>
        </md>
      </p>
      <p>
        <!-- <assemblage>
          <p> -->
            <md>
              <mrow>\amp\small\DLBa s^2Y - sy(0) - y'(0) + Y = \frac{2}{s^3}</mrow>
              <mrow>\amp\small\qquad\qquad {\Big\downarrow}\quad\text{Solve for}\ Y</mrow>
              <mrow>\amp\small\DLBa Y(s) = \frac{s}{s^2 + 1} + \frac{2}{s^3(s^2 + 1)}</mrow>
              <mrow>\amp\small\qquad\qquad {\Big\downarrow}\ \ \text{Prepare for Inverse}</mrow>
              <mrow>\amp\small\DLBa Y(s) = \frac{3s}{s^2 + 1} - \frac{2}{s} + \frac{2}{s^3}</mrow>
            </md>
          <!-- </p>
        </assemblage> -->
      </p>
    </sidebyside>
  </paragraphs>

  <paragraphs xml:id="lt-roadmap-example-4">
		<title>Specific-Roadmap</title>
    <sidebyside widths="30% 15% 47%" valign="middle">
      <p><md>\small\ul{\quad\ \textbf{Original Domain}\ \quad}</md></p>
      <p/>
      <p><md>\small\DLBa\textbf{2️⃣ Laplace Domain}</md></p>
    </sidebyside>
    <sidebyside widths="29% 15% 48%" valign="top">
      <p>
        <md>
          <mrow>\small \os{\vphantom{m}}{ y'' + 6y' + 9y = 0 }</mrow>
          <mrow>\small y(0) = 3,\ y'(0) = -3</mrow>
          <mrow>\small \os{\large 🔺 🔺 🔺 🔺 🔺}{\text{Differential Equation}}</mrow>
          <mrow/>
          <mrow>\small \us{\large 🔻 🔻 🔻 🔻 🔻}{\text{Solution}}</mrow>
          <mrow>\small y(t) = (3 - 24t)e^{-3t}</mrow>
        </md>
      </p>
      <p>
        <md>
          <mrow>\small \underrightarrow{\text{1️⃣ Forward}}</mrow>
          <mrow>\small \text{Apply}\ \laplacesym</mrow>
          <mrow/>
          <mrow/>
          <mrow/>
          <mrow>\small \text{Apply}\ \laplacesym^{-1}</mrow>
          <mrow>\small \overleftarrow{\text{3️⃣ Backward}}</mrow>
        </md>
      </p>
      <p>
        <!-- <assemblage>
          <p> -->
            <md>
              <mrow>\amp\small\DLBa s^2Y - 3s + 3 + 6sY - 18 + 9Y = 0</mrow>
              <mrow>\amp\small\qquad\qquad {\Big\downarrow}\quad\text{Solve for}\ Y</mrow>
              <mrow>\amp\small\DLBa Y(s) = \frac{3s - 15}{(s + 3)^2}</mrow>
              <mrow>\amp\small\qquad\qquad {\Big\downarrow}\ \ \text{Prepare for Inverse}</mrow>
              <mrow>\amp\small\DLBa Y(s) = \frac{3}{s + 3} - \frac{24}{(s + 3)^2}</mrow>
            </md>
          <!-- </p>
        </assemblage> -->
      </p>
    </sidebyside>
  </paragraphs>

  <paragraphs xml:id="lt-roadmap-example-5">
		<title>Specific-Roadmap</title>
    <sidebyside widths="35% 15% 40%" valign="middle">
      <p><md>\small\ul{\quad\ \textbf{Original Domain}\ \quad}</md></p>
      <p/>
      <p><md>\small\DLBa\textbf{2️⃣ Laplace Domain}</md></p>
    </sidebyside>
    <sidebyside widths="37% 15% 38%" valign="top">
      <p>
        <md>
          <mrow>\small \os{\vphantom{m}}{ y''' + y'' - y' - y = 0 }</mrow>
          <mrow>\small y(0) = 1,\ y'(0) = 0,\ y''(0) = -1</mrow>
          <mrow>\small \os{\large 🔺 🔺 🔺 🔺 🔺}{\text{Differential Equation}}</mrow>
          <mrow/>
          <mrow>\small \us{\large 🔻 🔻 🔻 🔻 🔻}{\text{Solution}}</mrow>
          <mrow>\small y(t) = -\frac12e^{t} - \frac12e^{-t}</mrow>
        </md>
      </p>
      <p>
        <md>
          <mrow>\small \underrightarrow{\text{1️⃣ Forward}}</mrow>
          <mrow>\small \text{Apply}\ \laplacesym</mrow>
          <mrow/>
          <mrow/>
          <mrow/>
          <mrow>\small \text{Apply}\ \laplacesym^{-1}</mrow>
          <mrow>\small \overleftarrow{\text{3️⃣ Backward}}</mrow>
        </md>
      </p>
      <p>
        <!-- <assemblage>
          <p> -->
            <md>
              <mrow>\amp\small\DLBa s^3Y + s^2 + 1 + s^2Y + s</mrow>
              <mrow>\amp\small\DLBa \qquad\qquad - sY - 1 - Y = 0</mrow>
              <mrow>\amp\small\qquad\qquad {\Big\downarrow}\quad\text{Solve for}\ Y</mrow>
              <mrow>\amp\small\DLBa Y(s) = \frac{-s^2 - s}{s^3 + s^2 - s - 1}</mrow>
              <mrow>\amp\small\qquad\qquad {\Big\downarrow}\ \ \text{Prepare for Inverse}</mrow>
              <mrow>\amp\small\DLBa Y(s) = -\frac12\frac{1}{s - 1} - \frac12\frac{1}{s + 1}</mrow>
            </md>
          <!-- </p>
        </assemblage> -->
      </p>
    </sidebyside>
  </paragraphs>

  <paragraphs xml:id="lt-roadmap-example-6">
		<title>Specific-Roadmap</title>
    <sidebyside widths="34% 14% 44%" valign="middle">
      <p><md>\small\ul{\quad\ \textbf{Original Domain}\ \quad}</md></p>
      <p/>
      <p><md>\small\DLBa\textbf{2️⃣ Laplace Domain}</md></p>
    </sidebyside>
    <sidebyside widths="34% 14% 44%" valign="top">
      <p>
        <md>
          <mrow>\small \os{\vphantom{m}}{ y'' + 2y = e^{t} \cos(3t) }</mrow>
          <mrow>\small y(0) = 0,\ y'(0) = 0</mrow>
          <mrow>\small \os{\large 🔺 🔺 🔺 🔺 🔺}{\text{Differential Equation}}</mrow>
          <mrow/>
          <mrow>\small \us{\large 🔻 🔻 🔻 🔻 🔻}{\text{Solution}}</mrow>
          <mrow>\small y(t) = e^{t}\cos(3t) - \cos(\sqrt{2}t)</mrow>
        </md>
      </p>
      <p>
        <md>
          <mrow>\small \underrightarrow{\text{1️⃣ Forward}}</mrow>
          <mrow>\small \text{Apply}\ \laplacesym</mrow>
          <mrow/>
          <mrow/>
          <mrow/>
          <mrow>\small \text{Apply}\ \laplacesym^{-1}</mrow>
          <mrow>\small \overleftarrow{\text{3️⃣ Backward}}</mrow>
        </md>
      </p>
      <p>
        <!-- <assemblage>
          <p> -->
            <md>
              <mrow>\amp\small\DLBa s^2 Y + 2Y = \frac{s - 1}{(s - 1)^2 + 9}</mrow>
              <mrow>\amp\small\qquad\qquad {\Big\downarrow}\quad\text{Solve for}\ Y</mrow>
              <mrow>\amp\small\DLBa Y(s) = \frac{s - 1}{(s^2 + 2)[(s - 1)^2 + 9]}</mrow>
              <mrow>\amp\small\qquad\qquad {\Big\downarrow}\ \ \text{Prepare for Inverse}</mrow>
              <mrow>\amp\small\DLBa Y(s) = \frac{1}{(s - 1)^2 + 9} - \frac{s}{s^2 + 2}</mrow>
            </md>
          <!-- </p>
        </assemblage> -->
      </p>
    </sidebyside>
  </paragraphs>

  <!-- <paragraphs xml:id="lt-roadmap-example-7">

  </paragraphs> -->
</section>