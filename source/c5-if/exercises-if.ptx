<exercises label="if-exercises">

	<exercisegroup xml:id="if-concept-quiz">
		<title>💡 Conceptual Quiz</title>

		<introduction>
			<p>
				Answer the following questions to test your understanding of the integrating factor method.
			</p>
			<aside>
				<title>Abbreviations</title>
				<tabular>
					<col width="10%" />
					<col width="90%" />
					<row>
						<cell><p><em>DE</em></p></cell>
						<cell><em>Differential Equation</em></cell>
					</row>
					<row>
						<cell><p><em>IVP</em></p></cell>
						<cell><em>Initial Value Problem</em></cell>
					</row>
				</tabular>
			</aside>
		</introduction>

		<exercise label="if-cq">

			<task label="if-cq-tf-01">
				<title>👍👎</title>
				<statement correct="no">
					<p>
						The differential equation, below, is in standard form.
						<md>
							xy'+2xy=x^2
						</md>
					</p>
				</statement>
				<feedback>
					<p>
						This differential equation is not in the form <m>y'+P(x)y=Q(x)</m>.
					</p>
				</feedback>
				<hint>
					<p>
						Check to see that the differential equation is in the form <m>y'+P(x)y=Q(x)</m>.
					</p>
				</hint>
			</task>

			<task label="if-cq-tf-02">
				<title>👍👎</title>
				<statement correct="no">
					<p>
						The integrating factor method can be applied to the differential equation
						<md>
							y' = y^2 + x
						</md>.
					</p>
				</statement>
				<feedback>Since the term, <m>y^2</m>, is nonlinear, the differential equation is nonlinear and the integrating factor method does not apply here.</feedback>
			</task>

			<task label="if-cq-mc-01">
				<title>Integration Technique Used</title>
				<statement>
					<p>
					What integration technique is used to evaluate 
					<md>\int t^3 \ln t \, dt</md>?
					</p>
				</statement>
				<choices randomize="yes">
					<choice>
					<statement><p>Substitution.</p></statement>
					<feedback>Substitution isn't the best choice for this integral.</feedback>
					</choice>
					<choice correct="yes">
					<statement><p>Integration by parts.</p></statement>
					<feedback>Correct! Integration by parts handles products like <m>t^3 \ln t</m>.</feedback>
					</choice>
					<choice>
					<statement><p>Partial fraction decomposition.</p></statement>
					<feedback>Partial fractions don't apply here.</feedback>
					</choice>
					<choice>
					<statement><p>The product rule.</p></statement>
					<feedback>The product rule is for differentiation, not integration.</feedback>
					</choice>
				</choices>
			</task>

			<task label="if-cq-mc-02">
				<title>When to Use Direct Integration</title>
				<statement>
					<p>
					What method is used to solve a differential equation of the form 
					<md>\frac{d}{dx}[g(x,y)] = f(x)</md>?
					</p>
				</statement>
				<choices randomize="yes">
					<choice correct="yes">
					<statement><p>Direct integration.</p></statement>
					<feedback>Correct! Integrate both sides with respect to <m>x</m>.</feedback>
					</choice>
					<choice>
					<statement><p>Separation of variables.</p></statement>
					<feedback>Separation isn't needed<mdash />the equation integrates directly.</feedback>
					</choice>
					<choice>
					<statement><p>Substitution.</p></statement>
					<feedback>Substitution isn't the primary method here.</feedback>
					</choice>
					<choice>
					<statement><p>Partial fractions.</p></statement>
					<feedback>Partial fractions are sometimes used inside integration, but the method here is simply direct integration.</feedback>
					</choice>
				</choices>
			</task>

			<task label="if-cq-mc-03">
				<title>Conditions for Using the Integrating Factor Method</title>
				<statement>
					<p>
						What properties must a differential equation have for the integrating factor method to apply?
					</p>
				</statement>
				<choices randomize="yes" multiple-correct="yes">
					<choice correct="yes">
						<statement><p>First order.</p></statement>
						<feedback>Correct! IF method is for first-order equations.</feedback>
					</choice>
					<choice>
						<statement><p>Separable.</p></statement>
						<feedback>Separable equations don't require the integrating factor method.</feedback>
					</choice>
					<choice correct="yes">
						<statement><p>Linear.</p></statement>
						<feedback>Correct! The IF method works only for linear equations.</feedback>
					</choice>
					<choice>
						<statement><p>Quadratic.</p></statement>
						<feedback><q>Quadratic</q> refers to algebraic equations, not differential equations.</feedback>
					</choice>
				</choices>
			</task>

			<task label="if-cq-mc-04">
				<title>Choosing the Integrating Factor</title>
				<statement>
					<p>
						For the linear equation <m>y' + 3y = x</m>, what is the integrating factor?
					</p>
				</statement>
				<choices randomize="yes">
					<choice correct="yes">
						<statement><p><m>\ds e^{\int 3 \, dx} = e^{3x}</m></p></statement>
						<feedback>Correct! The integrating factor is built from <m>P(x) = 3</m>.</feedback>
					</choice>
					<choice>
						<statement><p><m>\ds e^{\int x \, dx} = e^{x^2/2}</m></p></statement>
						<feedback>This would come from <m>Q(x)</m>, not <m>P(x)</m><mdash />wrong choice.</feedback>
					</choice>
					<choice>
						<statement><p><m>\ds e^{-3x}</m></p></statement>
						<feedback>Watch the sign<mdash />the integrating factor has <m>e^{+\int P(x) dx}</m>.</feedback>
					</choice>
					<choice>
						<statement><p><m>\ds 3e^x</m></p></statement>
						<feedback>The integrating factor isn't just an arbitrary exponential<mdash />it comes from integrating <m>P(x)</m>.</feedback>
					</choice>
				</choices>
			</task>

			<task label="if-cq-mc-05">
				<title>Purpose of Multiplying by the Integrating Factor</title>
				<statement>
					<p>
					Why do we multiply a first-order linear equation by its integrating factor?
					</p>
				</statement>
				<choices randomize="yes">
					<choice correct="yes">
					<statement><p>To rewrite the equation so it can be integrated directly.</p></statement>
					<feedback>Correct! The integrating factor allows the left-hand side to become <m>\frac{d}{dx}[\mu(x)y]</m>, which is integrable.</feedback>
					</choice>
					<choice>
					<statement><p>To convert the equation into a separable equation.</p></statement>
					<feedback>Not quite<mdash />although integration becomes possible, the equation doesn't become separable.</feedback>
					</choice>
					<choice>
					<statement><p>To set up the product rule for solving the equation.</p></statement>
					<feedback>The product rule is reversed here, not applied to expand further.</feedback>
					</choice>
					<choice>
					<statement><p>To make the equation factorable.</p></statement>
					<feedback>The integrating factor rewrites the equation into an integrable form, not just a <q>factorable</q> one.</feedback>
					</choice>
				</choices>
			</task>

			<task label="if-cq-mc-06">
				<title>Next Step After Using the Integrating Factor</title>
				<statement>
					<p>
					You rewrote <m>\dfrac{dy}{dx} + 2y = 5</m> as 
					<md>\frac{d}{dx} \left[e^{2x} y\right] = 5e^{2x}</md>. 
					What should you do next?
					</p>
				</statement>
				<choices randomize="yes">
					<choice>
					<statement><p>Apply the product rule to expand the left-hand side.</p></statement>
					<feedback>The product rule was already reversed to reach this form; expanding again would undo progress.</feedback>
					</choice>
					<choice correct="yes">
					<statement><p>Integrate both sides to solve for <m>y</m>.</p></statement>
					<feedback>Correct! Once the left-hand side is a single derivative, integration gives the solution for <m>y</m>.</feedback>
					</choice>
					<choice>
					<statement><p>Multiply by another integrating factor.</p></statement>
					<feedback>Only one integrating factor is needed. Multiplying by another one is unnecessary.</feedback>
					</choice>
					<choice>
					<statement><p>Differentiate both sides to simplify the expression.</p></statement>
					<feedback>Further differentiation is not needed; integration is the next step.</feedback>
					</choice>
				</choices>
			</task>

			<task label="if-cq-mc-07">
				<title>Choosing the IF for a Given Equation</title>
				<statement>
					<p>
					Find the integrating factor for 
					<md>x^2 y' - y = 1</md>.
					</p>
				</statement>
				<choices randomize="yes">
					<choice>
					<statement><p><m>e^{1/x^2}</m></p></statement>
					<feedback>Not quite<mdash />check the exponent carefully.</feedback>
					</choice>
					<choice>
					<statement><p><m>x^2</m></p></statement>
					<feedback>This is not the exponential integrating factor needed.</feedback>
					</choice>
					<choice correct="yes">
					<statement><p><m>e^{1/x}</m></p></statement>
					<feedback>Correct! The integrating factor comes from <m>P(x) = -\frac{1}{x^2}</m>.</feedback>
					</choice>
					<choice>
					<statement><p><m>\frac{1}{x}</m></p></statement>
					<feedback>This is not the correct integrating factor.</feedback>
					</choice>
				</choices>
			</task>

			<task label="if-cq-mc-08">
				<title>Sequence of IF Method Steps</title>
				<statement>
					<p>
						Which of the following best represents a succinct version of the integrating factor method? Let <m>\mu</m> be the integrating factor.
					</p>
				</statement>
				<choices randomize="yes">
					<choice correct="yes">
					<statement><p>standard form<mdash />compute <m>\mu</m><mdash />multiply <m>\mu</m><mdash />integrate<mdash />isolate</p></statement>
					<feedback>Correct! That's the sequence every time.</feedback>
					</choice>
					<choice>
					<statement><p>compute <m>\mu</m><mdash />multiply <m>\mu</m><mdash />differentiate<mdash />isolate</p></statement>
					<feedback>Differentiation is not used.</feedback>
					</choice>
					<choice>
					<statement><p>integrate<mdash />compute <m>\mu</m><mdash />multiply <m>\mu</m><mdash />standard form<mdash />isolate.</p></statement>
					<feedback>Correct steps, wrong order.</feedback>
					</choice>
					<choice>
					<statement><p>isolate<mdash />standard form<mdash />compute <m>\mu</m><mdash />multiply <m>\mu</m><mdash />integrate.</p></statement>
					<feedback>Correct steps, wrong order.</feedback>
					</choice>
				</choices>
			</task>

			<task label="if-cq-sa-01">
				<title>Classification of DEs for the Integrating Factor Method</title>
				<statement>
					<p>What type of differential equations can be solved using the integrating factor method?</p>
				</statement>
				<response/>
				<answer>
					<p>The integrating factor method applies to <alert>first-order linear</alert> differential equations.</p>
				</answer>
			</task>

			<task label="if-cq-sa-02">
				<title>Equations Outside Separation and IF Methods</title>
				<statement>
					<p>
						Classify all first-order differential equations that cannot be solved by 
						either separation of variables or the integrating factor method. Provide 
						an example of such an equation.
					</p>
				</statement>
				<response/>
				<answer>
					<p><alert>Nonlinear and non-separable</alert> first-order equations. Example: <m>y' = y^2 + x</m>.</p>
				</answer>
				<solution>
					<p>
						These are <alert>nonlinear and non-separable</alert> first-order equations. 
						They fall outside both common solution techniques.
					</p>
					<p>
						Examples include:
						<md>
							\frac{dy}{dx} = y^2 + x, \qquad \left(y + \frac{dy}{dx}\right)^2 
								= e^x, \qquad y' = \ln\left(x^3 y\right)
						</md>
					</p>
				</solution>
			</task>

			<task label="if-cq-sa-03">
				<title>Rewrite into Standard Linear Form</title>

				<statement>
					<p>
						Rewrite the differential equation below in the standard form <m>y' + P(x)y = Q(x)</m>. 
						Identify <m>P(x)</m> and <m>Q(x)</m>, state its order, and determine whether it is linear.
						<md>-4xy' + 5y = \cos (x)\,y - 1</md>
					</p>
				</statement>
				<response/>
				<answer>
					<p>
						<ul marker="square">
							<li><m>y' + \left(\frac{\cos x - 5}{4x}\right) y = \frac{1}{4x}</m></li>
							<li><m>P(x) = \frac{\cos x - 5}{4x}</m></li>
							<li><m>Q(x) = \frac{1}{4x}</m></li>
							<li>Order: first</li>
							<li>Classification: linear</li>
						</ul>
					</p>
				</answer>
			</task>
		</exercise>
	</exercisegroup>

	<exercisegroup xml:id="if-drills">
		<title>🏋️‍♂️ Practice Drills</title>

		<introduction>
			<p>
				More practice to strengthen your understanding.
			</p>
		</introduction>

		<exercise label="if-drill-if-applies">
			<title>Identifying Equations for the IF Method</title>

			<statement>
				<p>
					Which of the following differential equations can be solved using the integrating factor method?
				</p>
			</statement>

			<areas>
				<tabular>
					<row>
						<cell><area correct="yes"><m>\large y' + 2y = 3x</m></area></cell>
						<cell/>
						<cell><area correct="yes"><m>\large \dfrac{y'}{t^2} + y = 17t</m></area></cell>
						<cell/>
						<cell><area correct="no"><m>\large y'' + 2x y = 0</m></area></cell>
					</row>
					<row><cell><m/></cell><cell><m/></cell><cell><m/></cell><cell><m/></cell><cell><m/></cell></row>
					<row>
						<cell><area correct="no"><m>\large y' + y^2 = 17t</m></area></cell>
						<cell/>
						<cell><area correct="yes"><m>\large \dfrac{y'}{t} + y = 17t</m></area></cell>
						<cell/>
						<cell><area correct="yes"><m>\large \cos x \ y = y' - e^x</m></area></cell>
					</row>
				</tabular>
			</areas>

			<hint>
				<p>
				A first-order linear equation has <m>y</m> and <m>y'</m> only to the first power and not inside nonlinear functions.
				</p>
			</hint>
			<answer>
				<p>
					<m>y' + 2y = 3x</m>, <m>\dfrac{y'}{t^2} + y = 17t</m>, <m>\dfrac{y'}{t} + y = 17t</m>, and <m>\cos x \ y = y' - e^x</m> can be solved using the integrating factor method.
				</p>
			</answer>

			<feedback>
				<p>
				Four of these equations are linear and first-order<mdash />they can be solved by the integrating factor method.
				</p>
			</feedback>

			<solution>
				<p>
					The integrating factor method applies to first-order linear differential equations of the form <m>y' + P(x)y = Q(x)</m>. We check each equation:
					<ul>
						<li><m>y' + 2y = 3x</m> <mdash /> First-order linear. <alert>Can use IF.</alert></li>
						<li><m>\dfrac{y'}{t^2} + y = 17t</m> <mdash /> Multiply by <m>t^2</m> to get <m>y' + t^2y = 17t^3</m>. First-order linear. <alert>Can use IF.</alert></li>
						<li><m>y'' + 2x y = 0</m> <mdash /> Second-order equation (has <m>y''</m>). <em>Cannot use IF.</em></li>
						<li><m>y' + y^2 = 17t</m> <mdash /> Has <m>y^2</m> term, which makes it nonlinear. <em>Cannot use IF.</em></li>
						<li><m>\dfrac{y'}{t} + y = 17t</m> <mdash /> Multiply by <m>t</m> to get <m>y' + ty = 17t^2</m>. First-order linear. <alert>Can use IF.</alert></li>
						<li><m>\cos x \ y = y' - e^x</m> <mdash /> Rearrange as <m>y' - \cos x \cdot y = e^x</m>. First-order linear. <alert>Can use IF.</alert></li>
					</ul>
				</p>
				<p>
					Four equations can be solved using the integrating factor method.
				</p>
			</solution>
		</exercise>
	</exercisegroup>

	<exercisegroup cols="2" xml:id="if-drill-which-method">
		<title>🏋️‍♂️ Which Method Applies</title>

		<introduction>
			<p>
			For each differential equation, select the statement that applies and explain how you know. 
			<em>Do not solve any of the equations.</em>
				<ol marker="i.">
					<li>Can be solved by separating variables, but not using an integrating factor.</li>
					<li>Can be solved using an integrating factor, but not by separating variables.</li>
					<li>Can be solved both by using an integrating factor and by separating variables.</li>
					<li>Cannot be solved using either technique.</li>
				</ol>
			</p>
		</introduction>

		<exercise label="if-drill-which-method-1">
			<statement><p><m>x^2 \dfrac{dy}{dx} + \cos x = y</m></p></statement>
			<answer>
			<p>b. Can be solved using an integrating factor, but not by separating variables.</p>
			</answer>
			<solution>
			<p>
				This DE is first-order and linear, so it can be solved using an integrating factor.
			</p>
			<p>
				It is <em>not</em> separable. After isolating the derivative:
				<md>\dfrac{dy}{dx} = \dfrac{y - \cos x}{x^2},</md>
				we see that <m>y</m> and <m>x</m> cannot be separated by multiplication or division.
			</p>
			<p>
				Therefore, this DE can be solved using an integrating factor, but not by separating variables.
			</p>
			</solution>
		</exercise>

		<exercise label="if-drill-which-method-2">
			<statement><p><m>\dfrac{dx}{dt} + xt = e^x</m></p></statement>
			<answer>
			<p>d. Cannot be solved using either technique.</p>
			</answer>
			<solution>
			<p>
				This DE is first-order but <em>not</em> linear because the dependent variable <m>x</m> appears inside the nonlinear term <m>e^x</m>.
			</p>
			<p>
				It is also not separable. After isolating the derivative:
				<md>\frac{dx}{dt} = e^x - xt,</md>
				there's no way to write the right-hand side as a product of a function of <m>x</m> and a function of <m>t</m>.
			</p>
			<p>
				Therefore, this DE cannot be solved using either technique.
			</p>
			</solution>
		</exercise>

		<exercise label="if-drill-which-method-3">
			<statement><p><m>(t^2 + 1) \dfrac{dy}{dt} = yt - y</m></p></statement>
			<answer>
			<p>c. Can be solved both by using integrating factor and by separating variables.</p>
			</answer>
			<solution>
			<p>
				This DE is first-order and linear, so it can be solved using an integrating factor.
			</p>
			<p>
				It is also separable. Solving for the derivative:
				<md>
				<mrow>(t^2 + 1) \frac{dy}{dt} \amp = yt - y</mrow>
				<mrow>\frac{dy}{dt} \amp = \frac{yt - y}{t^2+1}</mrow>
				<mrow>\frac{dy}{dt} \amp = \frac{y(t - 1)}{t^2+1}</mrow>
				<mrow>\frac{dy}{dt} \amp = y \cdot \frac{t - 1}{t^2+1}</mrow>
				</md>
				Here, we can separate the variables: <m>\dfrac{dy}{y} = \dfrac{t - 1}{t^2 + 1} dt</m>.
			</p>
			<p>
				Therefore, this DE can be solved both by using an integrating factor and by separating variables.
			</p>
			</solution>
		</exercise>

		<exercise label="if-drill-which-method-4">
			<statement><p><m>\dfrac{dy}{dt} - y^2 t = t</m></p></statement>
			<answer>
			<p>a. Can be solved by separating variables, but not using an integrating factor.</p>
			</answer>
			<solution>
			<p>
				This DE is first-order but <em>not</em> linear because the dependent variable <m>y</m> is raised to a power (<m>y^2</m>).
			</p>
			<p>
				It <em>is</em> separable. Solving for the derivative:
				<md>
				<mrow>\frac{dy}{dt} - y^2 t \amp = t</mrow>
				<mrow>\frac{dy}{dt} \amp = t + y^2 t</mrow>
				<mrow>\frac{dy}{dt} \amp = t \cdot (1 + y^2)</mrow>
				</md>
				allows us to separate variables: <m>\dfrac{dy}{1+y^2} = t \, dt</m>.
			</p>
			<p>
				Therefore, this DE can be solved by separating variables, but not using an integrating factor.
			</p>
			</solution>
		</exercise>

		<exercise label="if-drill-which-method-5">
			<statement><p><m>3r = \dfrac{dr}{d\theta} - \theta^3</m></p></statement>
			<answer>
			<p>b. Can be solved using an integrating factor, but not by separating variables.</p>
			</answer>
			<solution>
			<p>
				This DE is first-order and linear, so it can be solved using an integrating factor.
			</p>
			<p>
				It is <em>not</em> separable. Solving for the derivative:
				<md>\frac{dr}{d\theta} = 3r + \theta^3,</md>
				shows no way to separate <m>r</m> and <m>\theta</m> into separate multiplicative terms.
			</p>
			<p>
				Therefore, this DE can be solved using an integrating factor, but not by separating variables.
			</p>
			</solution>
		</exercise>
	</exercisegroup>

	<exercisegroup cols="2" label="if-problem-gen-sol">
		<title>✍🏻 General Solution</title>

		<introduction>
			<p>
			Use an integrating factor to find the general solution to each equation.
			</p>
		</introduction>

		<exercise label="if-problem-gen-sol-1">
			<statement><p><m>y' - 4y = x</m></p></statement>
			<answer>
			<p><m>y = -\frac{1}{4}x - \frac{1}{16} + Ce^{4x}</m></p>
			</answer>
			<solution>
			<p>
				Standard form: <m>y' + (-4)y = x</m>, so <m>P(x) = -4</m>.  
				Integrating factor: <m>\mu(x) = e^{\int -4 dx} = e^{-4x}</m>.
				<md>
					<mrow>e^{-4x}y' - 4e^{-4x}y \amp = xe^{-4x}</mrow>
					<mrow>\frac{d}{dx}[e^{-4x}y] \amp = xe^{-4x}</mrow>
				</md>
			</p>
			<p>
				Integrate: 
				<md>
					<mrow>e^{-4x}y \amp = \int xe^{-4x} dx = -\frac{1}{4}xe^{-4x} - \frac{1}{16}e^{-4x} + C</mrow>
					<mrow>y \amp = -\frac{1}{4}x - \frac{1}{16} + Ce^{4x}</mrow>
				</md>
			</p>
			</solution>
		</exercise>

		<exercise label="if-problem-gen-sol-2">
			<statement><p><m>x^2 y' - y = 1, \quad x &gt; 0</m></p></statement>
			<answer>
			<p><m>y = -1 + Ce^{-1/x}</m></p>
			</answer>
			<solution>
			<p>
				Standard form: <m>y' - \frac{1}{x^2}y = \frac{1}{x^2}</m>.  
				Integrating factor: <m>\mu(x) = e^{\int -\frac{1}{x^2}dx} = e^{1/x}</m>.
				<md>
					<mrow>\frac{d}{dx}[e^{1/x}y] \amp = \frac{e^{1/x}}{x^2}</mrow>
					<mrow>e^{1/x}y \amp = -e^{1/x} + C</mrow>
					<mrow>y \amp = -1 + Ce^{-1/x}</mrow>
				</md>
			</p>
			</solution>
			<solution><title>(detailed)</title>
				<p>
					We put the equation in standard form to identify <m>P(x)</m> and compute the integrating factor.
				</p>
					
				<p>
					<md>
						y' + \us{P}{\boxed{-\frac{1}{x^2}}}\ y = \frac{1}{x^2} \quad \implies \quad
						\mu(x) = e^{\large \int -\sfrac{1}{x^2} dx} = e^{1/x}
					</md>
				</p>
					
				<p>
					Multiply by <m>e^{1/x}</m> and reverse the product rule on the left side.
					<md>
						<mrow> e^{1/x}y' - \frac{e^{1/x}}{x^2} y	\amp = \frac{e^{1/x}}{x^2}	</mrow>
						<mrow> \frac{d}{dx}\left[e^{1/x} y\right]	\amp = \frac{e^{1/x}}{x^2}	</mrow>
					</md>
				</p>
					
				<p>
					Next, integrate both sides and use <m>u</m>-substitution on the right side.
				</p>
				<sidebyside widths="10% 60% 25% 5%" valigns="top top top top">

					<p/>
					<p>
						<md>
							<mrow>
								\int \frac{d}{dx}\left[e^{1/x} y\right] dx
												\amp = \int \frac{e^{1/x}}{x^2} dx \qquad \rightarrow
							</mrow>
							<mrow>	e^{1/x} y	\amp = \int -e^u du </mrow>
							<mrow>	e^{1/x} y	\amp = -e^u + C		</mrow>
							<mrow>	e^{1/x} y	\amp = -e^{1/x} + C	</mrow>
						</md>
					</p>
					<p>
						<md>
							<mrow>	u	\amp = \frac{1}{x}			</mrow>
							<mrow>	du	\amp = -\frac{1}{x^2} dx	</mrow>
						</md>
					</p>
					<p/>

				</sidebyside>
				<p>
							
					Finally, solve for <m>y</m>:
					<md>
						<mrow> y = -1 + Ce^{-1/x}	</mrow>
					</md>
				</p>
			</solution>
		</exercise>

		<exercise label="if-problem-gen-sol-3">
			<statement><p><m>\dfrac{dy}{dx} - y = e^{3x}</m></p></statement>
			<answer>
			<p><m>y = \frac{1}{2}e^{3x} + Ce^{x}</m></p>
			</answer>
			<solution>
			<p>
				Already in standard form: <m>y' + (-1)y = e^{3x}</m>.  
				Integrating factor: <m>\mu(x) = e^{\int -1 dx} = e^{-x}</m>.
				<md>
					<mrow>\frac{d}{dx}[e^{-x}y] \amp = e^{2x}</mrow>
					<mrow>e^{-x}y \amp = \frac{1}{2}e^{2x} + C</mrow>
					<mrow>y \amp = \frac{1}{2}e^{3x} + Ce^{x}</mrow>
				</md>
			</p>
			</solution>
		</exercise>

		<exercise label="if-problem-gen-sol-4">
			<statement><p><m>\dfrac{dy}{dx} = \dfrac{y}{x} + 2x + 1,\quad x &gt; 0</m></p></statement>
			<answer>
			<p><m>y = 2x^2 + x\ln x + Cx</m></p>
			</answer>
			<solution>
			<p>
				Standard form: <m>y' - \frac{1}{x}y = 2x + 1</m>.  
				Integrating factor: <m>\mu(x) = e^{\int -\frac{1}{x}dx} = \frac{1}{x}</m>.
				<md>
					<mrow>\frac{d}{dx}\left[\frac{1}{x}y\right] \amp = 2 + \frac{1}{x}</mrow>
					<mrow>\frac{1}{x}y \amp = 2x + \ln x + C</mrow>
					<mrow>y \amp = 2x^2 + x \ln x + Cx</mrow>
				</md>
			</p>
			</solution>
		</exercise>

		<exercise label="if-problem-gen-sol-5">
			<statement><p><m>y\dfrac{dx}{dy} + 2x = 5y^3 </m></p></statement>
			<answer>
			<p><m>x = y^3 + \frac{C}{y^2}</m></p>
			</answer>
			<solution>
			<p>
				Treat <m>x</m> as dependent: <m>x' + \frac{2}{y}x = 5y^2</m> with <m>x' = \frac{dx}{dy}</m>.  
				Integrating factor: <m>\mu(y) = e^{\int \frac{2}{y}dy} = y^2</m>.
				<md>
					<mrow>\frac{d}{dy}[y^2 x] \amp = 5y^4</mrow>
					<mrow>y^2 x \amp = y^5 + C</mrow>
					<mrow>x \amp = y^3 + \frac{C}{y^2}</mrow>
				</md>
			</p>
			</solution>
		</exercise>

		<exercise label="if-problem-gen-sol-6">
			<statement><p><m>-\dfrac{4M}{t^2} = t^5 - \dfrac{1}{t}\frac{dM}{dt} + 1</m></p></statement>
			<answer>
			<p><m>M = \frac{1}{3}t^{7} - \frac{1}{2}t^{2} + Ct^{4}</m></p>
			</answer>
			<solution>
			<p>
				Rewrite: <m>M' - \frac{4}{t}M = t^6 + t</m> with <m>M' = \frac{dM}{dt}</m>.  
				Integrating factor: <m>\mu(t) = e^{\int -\frac{4}{t} dt} = t^{-4}</m>.
				<md>
					<mrow>\frac{d}{dt}[t^{-4}M] \amp = t^2 + t^{-3}</mrow>
					<mrow>t^{-4}M \amp = \frac{1}{3}t^{3} - \frac{1}{2}t^{-2} + C</mrow>
					<mrow>M \amp = \frac{1}{3}t^{7} - \frac{1}{2}t^{2} + Ct^{4}</mrow>
				</md>
			</p>
			</solution>
			<solution><title>(detailed)</title>
				<p>
					As always, start by putting the equation in standard form:
					<md>
						<mrow> \frac{1}{t} \frac{dM}{dt} - \frac{4}{t^2} \cdot M		\amp =  t^5 + 1	</mrow>
						<mrow> \frac{dM}{dt} + \us{P}{\boxed{-\frac{4}{t}}} \cdot M		\amp = t^6 + t	</mrow>
					</md>.
				</p>

				<sidebyside widths="35% 65%" valign="middle">
					<p>Find Integrating Factor, <m>\mu</m></p>
					<p>
						<md>
							\mu = e\vphantom{\large|}^{\int \sfrac{-4}{t}\ dt} = e^{-4\ln t} = e^{\ln t^{-4}} = t^{-4}
						</md>
					</p>
				</sidebyside>

				<sidebyside widths="35% 65%" valign="middle">
					<p>Multiply by <m>\mu</m></p>
					<p>
						<md>
							<mrow>
								t^{-4} \frac{dM}{dt} - t^{-4} \frac{4}{t} M
									\amp = t^{-4}(t^6 + t)
							</mrow>
						</md>
					</p>
				</sidebyside>

				<sidebyside widths="35% 65%" valign="middle">	
					<p>Complete the Product Rule</p>
					<p>
						<md>
							<mrow>
								\frac{d}{dt}\left[ \frac{1}{t^4} M \right]
									\amp = t^2 + t^{-3}
							</mrow>
						</md>
					</p>
				</sidebyside>

				<sidebyside widths="35% 65%" valign="middle">
					<p>Integrate Both Sides</p>
					<p>
						<md>
							<mrow>
								\int \frac{d}{dt}\left[ \frac{1}{t^4} M \right]\ dt
									= \int \left(t^2 + t^{-3}\right) dt
							</mrow>
						</md>
					</p>
				</sidebyside>

				<sidebyside widths="35% 65%" valign="middle">
					<p>Isolate <m>M</m></p>
					<p>
						<md>
							<mrow>
								\frac{1}{t^4} M = \frac{1}{3}t^{3} - \frac{1}{2}t^{-2} + C
							</mrow>
						</md>
					</p>
				</sidebyside>

				<sidebyside widths="35% 65%" valign="middle">		
					<p>General Solution</p>
					<p>
						<md>
							M = \frac{1}{3}t^{7} - \frac{1}{2}t^2 + Ct^4
						</md>.
					</p>
				</sidebyside>
			</solution>
		</exercise>

		<exercise label="if-problem-gen-sol-7">
			<statement><p><m>\dfrac{dy}{dx} + 4x^3 y = 5xe^{-x^4}</m></p></statement>
			<answer>
			<p><m>y = \frac{5}{2}x^2 e^{-x^4} + Ce^{-x^4}</m></p>
			</answer>
			<solution>
			<p>
				Standard form with <m>P(x) = 4x^3</m>.  
				Integrating factor: <m>\mu(x) = e^{\int 4x^3 dx} = e^{x^4}</m>.
				<md>
					<mrow>\frac{d}{dx}[e^{x^4}y] \amp = 5x</mrow>
					<mrow>e^{x^4}y \amp = \frac{5}{2}x^2 + C</mrow>
					<mrow>y \amp = \frac{5}{2}x^2 e^{-x^4} + Ce^{-x^4}</mrow>
				</md>
			</p>
			</solution>
		</exercise>

		<exercise label="if-problem-gen-sol-8">
			<statement><p><m>\dfrac{dr}{d\theta} + r\tan \theta = \sec \theta,\ \ -\frac{\pi}{2} \le \theta \le \frac{\pi}{2}</m></p></statement>
			<answer>
			<p><m>r = \sin\theta + C\cos\theta</m></p>
			</answer>
			<solution>
			<p>
				Standard form: <m>r' + \tan\theta r = \sec\theta</m> with <m>r' = \frac{dr}{d\theta}</m>.  
				Integrating factor: <m>\mu(\theta) = e^{\int \tan\theta d\theta} = \sec\theta</m>.
				<md>
					<mrow>\frac{d}{d\theta}[\sec\theta r] \amp = \sec^2\theta</mrow>
					<mrow>\sec\theta r \amp = \tan\theta + C</mrow>
					<mrow>r \amp = \sin\theta + C\cos\theta</mrow>
				</md>
			</p>
			</solution>
		</exercise>
	</exercisegroup>

	<exercisegroup xml:id="if-problem-ivp">
		<title>✍🏻 Initial-Value Problems</title>

		<introduction>
			<p>
			Solve each initial value problem.
			</p>
		</introduction>

		<exercise label="if-problem-ivp-1">
			<statement><p><m>\dfrac{dy}{dx} - \dfrac{y}{x} = xe^x,\quad y(1) = e - 1 \quad (x &gt; 0)</m></p></statement>
			<answer>
			<p><m>y = x(e^x - 1)</m></p>
			</answer>
			<solution>
			<p>
				Standard form: <m>y' - \frac{1}{x} y = x e^x</m>.  
				Integrating factor: <m>\mu(x) = e^{\int -\frac{1}{x} dx} = x^{-1}</m>.
				<md>
					<mrow>\frac{d}{dx}\left[\frac{1}{x}y\right] \amp = e^x</mrow>
					<mrow>\frac{1}{x}y \amp = \int e^x dx = e^x + C</mrow>
					<mrow>y \amp = x(e^x + C)</mrow>
				</md>
			</p>
			<p>
				Apply <m>y(1) = e - 1</m>:
				<md>
					e - 1 = 1(e + C) \Rightarrow C = -1.
				</md>
			</p>
			<p>
				Final solution:
				<md>
					y(x) = x(e^x - 1).
				</md>
			</p>
			</solution>
		</exercise>

		<exercise label="if-problem-ivp-2">
			<statement><p><m>e^t z' = 1 - 4e^t z,\quad z(0) = \dfrac{4}{3}</m></p></statement>
			<answer>
			<p><m>z = \frac{1}{3}e^{-t} + e^{-4t}</m></p>
			</answer>
			<solution>
			<p>
				Divide by <m>e^t</m>: <m>z' + 4z = e^{-t}</m>.  
				Integrating factor: <m>\mu(t) = e^{\int 4 dt} = e^{4t}</m>.
				<md>
					<mrow>\frac{d}{dt}[e^{4t}z] \amp = e^{4t} e^{-t} = e^{3t}</mrow>
					<mrow>e^{4t}z \amp = \frac{1}{3} e^{3t} + C</mrow>
					<mrow>z \amp = \frac{1}{3}e^{-t} + Ce^{-4t}</mrow>
				</md>
			</p>
			<p>
				Apply <m>z(0) = \frac{4}{3}</m>:
				<md>
					\frac{4}{3} = \frac{1}{3} + C \Rightarrow C = 1.
				</md>
			</p>
			<p>
				Final solution:
				<md>
					z(t) = \frac{1}{3}e^{-t} + e^{-4t}.
				</md>
			</p>
			</solution>
		</exercise>

		<exercise label="if-problem-ivp-3">
			<statement><p><m>y' - 3y = 6,\quad y(0) = 5</m></p></statement>
			<answer>
			<p><m>y = -2 + 7e^{3x}</m></p>
			</answer>
			<solution>
				<p>
					Standard form with <m>P(x) = -3</m>.  
					Integrating factor: <m>\mu(x) = e^{\int -3 dx} = e^{-3x}</m>.
					<md>
						<mrow>\frac{d}{dx}[e^{-3x}y] \amp = 6e^{-3x}</mrow>
						<mrow>e^{-3x}y \amp = -2e^{-3x} + C</mrow>
						<mrow>y \amp = -2 + Ce^{3x}</mrow>
					</md>
				</p>
				<p>
					Apply <m>y(0) = 5</m>:
					<md>
						5 = -2 + C \Rightarrow C = 7.
					</md>
				</p>
				<p>
					Final solution:
					<md>
						y(x) = -2 + 7e^{3x}.
					</md>
				</p>
			</solution>
		</exercise>
	</exercisegroup>
</exercises>